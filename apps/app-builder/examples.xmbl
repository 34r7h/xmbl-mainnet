  <!-- <general xid="eventDemo" :xelements="[
    {
      tag: 'div',
      style: { padding: '20px', border: '1px solid #ccc' },
      children: [
        {
          tag: 'p',
          id: 'demoText',
          content: 'Hover, click, or change the input below!'
        },
        {
          tag: 'button',
          events: {
            click: 'handleClick',
            mouseover: 'handleMouseOver',
            mouseout: 'handleMouseOut'
          },
          style: {
            padding: '10px',
            backgroundColor: '#2196F3',
            color: 'white',
            cursor: 'pointer'
          },
          content: 'Click/Hover Me'
        },
        {
          tag: 'input',
          id: 'myInput',
          events: {
            change: 'handleInputChange'
          },
          style: {
            marginTop: '10px'
          },
          attrs: {
            type: 'text',
            placeholder: 'Type here...'
          }
        },
        {
          tag: 'p',
          id: 'inputDisplay',
          content: 'Input: '
        },
        {
          tag: 'div',
          events: {
            click: 'clickDiv'
          },
          style: {
            marginTop: '10px',
            backgroundColor: 'lightblue',
            padding: '10px',
            cursor: 'pointer'
          },
          content: 'Click this div'
        },
      ]
    }
  ]" :xmethods="{
    handleClick: `
        const target = elements[0].children.find(el => el.id === 'demoText');
        if (target) {
          target.content = 'Button clicked!';
        }
        console.log('Button clicked!', event);
      `,
    handleMouseOver: `
        const target = elements[0].children.find(el => el.id === 'demoText');
        if (target) {
          target.content = 'Mouse over button!';
        }
        console.log('Mouse over!', event);
      `,
    handleMouseOut: `
        const target = elements[0].children.find(el => el.id === 'demoText');
        if (target) {
          target.content = 'Hover, click, or change the input below!';
        }
        console.log('Mouse out!', event);
      `,
    handleInputChange: `
        const input = elements[0].children.find(el => el.id === 'myInput');
        const display = elements[0].children.find(el => el.id === 'inputDisplay');
        if (input && display) {
          display.content = 'Input: ' + event.target.value;
        }
        console.log('Input changed!', event.target.value);
      `,
    clickDiv: `
        console.log('Div Clicked', event);
        alert('Div Clicked');
      `
  }" /> -->

