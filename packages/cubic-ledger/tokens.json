{
  "transactionTypes": {
    "identity": {
      "type": "identity",
      "description": "Identity transaction - signing the public key",
      "fields": {
        "publicKey": "string",
        "signature": "string",
        "timestamp": "number"
      },
      "required": [
        "publicKey",
        "signature"
      ]
    },
    "utxo": {
      "type": "utxo",
      "description": "UTXO transaction - coin/token transfer",
      "fields": {
        "from": "string|array",
        "to": "string|array",
        "amount": "number|string",
        "fee": "number|string",
        "stake": "number|string",
        "timestamp": "number"
      },
      "required": [
        "from",
        "to",
        "amount"
      ]
    },
    "token_creation": {
      "type": "token_creation",
      "description": "Token creation transaction - XMBL NFT",
      "fields": {
        "creator": "string",
        "tokenId": "string",
        "metadata": "object",
        "supply": "number|string",
        "timestamp": "number"
      },
      "required": [
        "creator",
        "tokenId"
      ]
    },
    "contract": {
      "type": "contract",
      "description": "Contract transaction - hash + ABI",
      "fields": {
        "contractHash": "string",
        "abi": "object|string",
        "deployer": "string",
        "bytecode": "string",
        "timestamp": "number"
      },
      "required": [
        "contractHash",
        "abi"
      ]
    },
    "state_diff": {
      "type": "state_diff",
      "description": "State diff transaction - function + args",
      "fields": {
        "function": "string",
        "args": "array|object",
        "contractAddress": "string",
        "caller": "string",
        "timestamp": "number"
      },
      "required": [
        "function",
        "args"
      ]
    },
    "anchor": {
      "type": "anchor",
      "description": "Handoff state anchor - hashes-only digest of an off-chain event (message/activity/task/settlement). Carries no value; sealed as a leaf block by its hash.",
      "fields": {
        "event": "string",
        "hash": "string",
        "ts": "number"
      },
      "required": [
        "event",
        "hash"
      ]
    },
    "tx": {
      "type": "tx",
      "description": "Type-6 value unit (paid activity: task.created/verified/settlement; enriched-type-6 per operator 2026-07-26). Content-addressed via shared micromining (xid carries the '06' prefix over the 8-field canonical body). from=[payer], to=[payee], amount=decimal-string, unspent=immutable denomination-at-mint (fungible=spendable value consumed by a type-7 how='spend' pointer, non-fungible=whole unit, ''=non-value payment record). The validatable value-tx that feeds the cube pipeline (e49408b7 tx-starvation cure). No sig in-body — payer sig is a separate type-7 pointer, deferred to layer-b; interim authorization is the settler's already-signature-authenticated verified-task gate.",
      "fields": {
        "chain": "string",
        "from": "array",
        "to": "array",
        "asset": "string",
        "amount": "string",
        "seq": "number",
        "prev": "string",
        "unspent": "string",
        "xid": "string",
        "nonce": "number"
      },
      "required": [
        "chain",
        "from",
        "to",
        "amount",
        "unspent",
        "xid",
        "nonce"
      ]
    }
  },
  "version": "1.0.0",
  "lastUpdated": "2025-01-27"
}